# SAM 3.1 uses these same two Meta settings (model sam-3.1 and the
# POST /v1/responses route are fixed in code). There is no separate
# SAM key, provider, model, or endpoint setting.
META_API_BASE_URL="https://api.meta.ai/v1"
META_API_KEY=""
META_CHAT_MODEL_ID="muse-spark-1.3"
BASETEN_BASE_URL="https://inference.baseten.co/v1"
BASETEN_API_KEY=""
BASETEN_MODEL_ID="meta-models/muse-spark-open-1026"
CHAT_PROVIDER="mock"
ENABLE_DISK_CACHE="true"
MAX_SESSION_SPEND_USD="5.00"
MAX_CUMULATIVE_SPEND_USD="135.00"
DEMO_OFFLINE_LOCK="false"
